[Unit]
Description=Cali camping unit control service
# No dependency on the network being up: control works without the Cerbo (S9) and without
# the router; the Cerbo client reconnects on its own once wlan0 is up.
After=network.target NetworkManager.service

[Service]
Type=simple
User=camper
Group=camper
SupplementaryGroups=gpio i2c dialout
Environment=CAMPERD_HAL=hw
Environment=CAMPERD_DATA=/data
WorkingDirectory=/data/releases/current
ExecStart=/data/releases/current/.venv/bin/python -m camperd --host 127.0.0.1 --port 8080
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
